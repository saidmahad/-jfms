# JUPA Fuel Station Management System — Backend environment
# Copy to .env and adjust. All variables are optional (sensible defaults exist).

# Port the API listens on
PORT=4000

# development | production | test  (test uses an in-memory database)
NODE_ENV=development

# JWT signing secret — CHANGE THIS IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime, e.g. 8h, 12h, 7d
JWT_EXPIRES_IN=12h

# SQLite database file (relative to backend/). Use :memory: for tests.
DB_PATH=./data/jfms.sqlite

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173
